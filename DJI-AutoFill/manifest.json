{
  "manifest_version": 3,
  "name": "DJI AutoFill",
  "version": "4.2.1",
  "description": "自动填写旧机信息、换购方案和联系信息，并进入下一步。",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://support.dji.com/*"
  ],
  "action": {
    "default_title": "DJI AutoFill",
    "default_popup": "popup.html"
  }
}